        "# Experiment: Read Image and Apply Gaussian Blur\n",
        "\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "# Step 1: Upload image (Choose File button)\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Step 2: Get uploaded file name automatically\n",
        "filename = list(uploaded.keys())[0]\n",
        "\n",
        "# Step 3: Read the image\n",
        "image = cv2.imread(filename)\n",
        "\n",
        "# Check if image loaded\n",
        "if image is None:\n",
        "    print(\"Error: Could not load image.\")\n",
        "else:\n",
        "    # Step 4: Apply Gaussian Blur\n",
        "    # (kernel size must be odd numbers like 3,5,7)\n",
        "    blurred_image = cv2.GaussianBlur(image, (5,5), 0)\n",
        "\n",
        "    # Step 5: Display Original and Blurred Image\n",
        "    plt.figure(figsize=(10,5))\n",
        "\n",
        "    # Original\n",
        "    plt.subplot(1,2,1)\n",
        "    plt.title(\"Original Image\")\n",
        "    plt.imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))\n",
        "    plt.axis('off')\n",
        "\n",
        "    # Blurred\n",
        "    plt.subplot(1,2,2)\n",
        "    plt.title(\"Gaussian Blurred Image\")\n",
        "    plt.imshow(cv2.cvtColor(blurred_image, cv2.COLOR_BGR2RGB))\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "    # Step 6: Convert blurred image to grayscale for graph\n",
        "    gray_blur = cv2.cvtColor(blurred_image, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "    # Step 7: Plot Histogram (Graph)\n",
        "    plt.figure()\n",
        "    plt.title(\"Histogram of Blurred Image\")\n",
        "    plt.xlabel(\"Pixel Intensity\")\n",
        "    plt.ylabel(\"Frequency\")\n",
        "    plt.hist(gray_blur.ravel(), bins=256)\n",
        "    plt.show()"
      ],
